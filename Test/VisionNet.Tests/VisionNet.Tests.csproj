<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>VisionNet.Tests</AssemblyName>
    <RootNamespace>VisionNet.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- VisionNet is built for x64, so the test host must be 64-bit too. -->
    <PlatformTarget>x64</PlatformTarget>
    <NoWarn>$(NoWarn);MSB3270</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VisionNet\VisionNet.csproj" />
  </ItemGroup>

</Project>
