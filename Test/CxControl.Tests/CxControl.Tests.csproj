<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>CxControl.Tests</AssemblyName>
    <RootNamespace>VisionNet.Controls.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- CxControl references an AMD64 VisionNet, so the test host must be 64-bit too. -->
    <PlatformTarget>x64</PlatformTarget>
    <NoWarn>$(NoWarn);MSB3270</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Controls\CxControl\CxControl.csproj" />
    <!-- CxControl references VisionNet as a binary (see its HintPath), so the test project
         needs its own reference to reach the VisionNet.DataType model types. -->
    <Reference Include="VisionNet">
      <HintPath>..\..\bin\Debug\VisionNet.dll</HintPath>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
  </ItemGroup>

</Project>
